---
// ==============================================================================
// src/components/AdSlot.astro
// Google AdSense Compliant Responsive Display Slot
// Max 3 slots per page • Never placed above H1 • Zero Cumulative Layout Shift (CLS)
// ==============================================================================

export interface Props {
  slotId: 'ad-slot-1-after-quickfacts' | 'ad-slot-2-mid-content' | 'ad-slot-3-pre-footer';
  className?: string;
}

const { slotId, className = '' } = Astro.props;
---

<aside
  class={`my-8 overflow-hidden rounded-2xl bg-slate-50/60 border border-slate-200/80 p-3 text-center transition ${className}`}
  aria-label="Advertisement"
>
  <div class="flex items-center justify-center mb-1.5">
    <span class="text-[9px] uppercase tracking-widest font-semibold text-slate-400">
      Sponsored
    </span>
  </div>

  <!-- Responsive Google AdSense Container -->
  <div class="min-h-[100px] w-full flex items-center justify-center text-slate-300 text-[11px]" id={slotId}>
    <ins
      class="adsbygoogle block w-full"
      style="display:block"
      data-ad-client="ca-pub-0000000000000000"
      data-ad-slot="0000000000"
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  </div>
</aside>
