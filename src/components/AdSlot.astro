---
// ==============================================================================
// src/components/AdSlot.astro
// Compliant Google AdSense Placeholder Slot (Enforces Max 3 Slots, Never Above H1)
// ==============================================================================

export interface Props {
  slotId: 'ad-slot-1-after-quickfacts' | 'ad-slot-2-mid-content' | 'ad-slot-3-pre-footer';
  className?: string;
}

const { slotId, className = '' } = Astro.props;
---

<div class={`my-8 overflow-hidden rounded-xl border border-dashed border-slate-300 bg-slate-50/80 p-4 text-center ${className}`}>
  <div class="flex items-center justify-center gap-2 mb-2">
    <span class="text-[10px] uppercase tracking-wider font-semibold text-slate-400 bg-slate-200/60 px-2 py-0.5 rounded">
      Advertisement Placeholder
    </span>
  </div>
  
  <!-- In production, replace data-ad-client and data-ad-slot with owner's AdSense tag -->
  <div class="min-h-[90px] flex flex-col items-center justify-center text-xs text-slate-400">
    <span class="font-mono text-[11px] text-slate-500">Google AdSense Container ({slotId})</span>
    <span class="text-[10px] text-slate-400 mt-1">Responsive display format • Auto-reserves height to prevent Cumulative Layout Shift (CLS)</span>
  </div>
</div>
