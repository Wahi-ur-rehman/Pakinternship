---
// ==============================================================================
// src/layouts/Layout.astro
// Production SEO & Core Web Vitals Optimized Layout
// ==============================================================================

import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  noindex = false,
  ogType = 'website',
  ogImage = 'https://pakistan-internships.pages.dev/og-default.png',
} = Astro.props;

const siteName = 'Pakistan Internships & Tech Jobs Portal';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Technical SEO Metadata -->
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_PK" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Inline JSON-LD Slot for Individual Postings (Section 9B: Never on list/category pages) -->
    <slot name="schema" />

    <style is:global>
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 antialiased selection:bg-emerald-100 selection:text-emerald-900">
    <!-- Top Announcement Bar (Human Verification Promise) -->
    <div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800">
      <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
        <p class="flex items-center gap-1.5 font-medium">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>100% Fact-Checked Engineering & IT Opportunities for Pakistani Students</span>
        </p>
        <div class="flex items-center gap-4 text-slate-400">
          <span>🇵🇰 Verified Stipends & Eligibility</span>
          <a href="/admin/review" class="text-emerald-400 hover:underline">Verification Gate</a>
        </div>
      </div>
    </div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold text-lg shadow-sm group-hover:bg-emerald-700 transition">
            PK
          </div>
          <div>
            <span class="block font-bold text-slate-900 text-base leading-tight group-hover:text-emerald-700 transition">PakInternships</span>
            <span class="block text-xs text-slate-500 font-medium">CS & Engineering Portal</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center gap-1 font-medium text-sm text-slate-600">
          <a href="/" class="px-3 py-2 rounded-lg hover:text-emerald-700 hover:bg-slate-100 transition">Home</a>
          <a href="/computer-science" class="px-3 py-2 rounded-lg hover:text-emerald-700 hover:bg-slate-100 transition">Computer Science</a>
          <a href="/engineering" class="px-3 py-2 rounded-lg hover:text-emerald-700 hover:bg-slate-100 transition">Engineering</a>
          <a href="/information-technology" class="px-3 py-2 rounded-lg hover:text-emerald-700 hover:bg-slate-100 transition">IT & DevOps</a>
          <a href="/authors/hamza-tariq" class="px-3 py-2 rounded-lg hover:text-emerald-700 hover:bg-slate-100 transition">Author Bio</a>
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="/admin/review"
            class="text-xs font-semibold px-3.5 py-2 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 hover:bg-emerald-100 transition"
          >
            Admin Gate
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="bg-white border-t border-slate-200 mt-16 text-slate-600 text-sm">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
          <!-- Col 1: About Portal -->
          <div class="md:col-span-1">
            <div class="flex items-center gap-2 font-bold text-slate-900 text-base mb-3">
              <div class="w-6 h-6 rounded-md bg-emerald-600 text-white flex items-center justify-center text-xs">PK</div>
              <span>PakInternships</span>
            </div>
            <p class="text-xs leading-relaxed text-slate-500 mb-3">
              A hyper-niche, fact-verified career portal dedicated to Pakistani undergraduate students in Computer Science, Software Engineering, and Core Engineering disciplines.
            </p>
            <p class="text-xs text-slate-400">
              Published under strict editorial and human-verification standards.
            </p>
          </div>

          <!-- Col 2: Categories -->
          <div>
            <h4 class="font-semibold text-slate-900 text-sm mb-3">Niche Tracks</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/computer-science" class="hover:text-emerald-700 transition">Computer Science & Software</a></li>
              <li><a href="/engineering" class="hover:text-emerald-700 transition">Electrical & Mechanical Engineering</a></li>
              <li><a href="/information-technology" class="hover:text-emerald-700 transition">Cloud, DevOps & QA</a></li>
            </ul>
          </div>

          <!-- Col 3: Legal & Trust (Section 10 requirement) -->
          <div>
            <h4 class="font-semibold text-slate-900 text-sm mb-3">Trust & Transparency</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/about" class="hover:text-emerald-700 transition">About Our Mission</a></li>
              <li><a href="/contact" class="hover:text-emerald-700 transition">Contact & Corrections</a></li>
              <li><a href="/privacy-policy" class="hover:text-emerald-700 transition">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-emerald-700 transition">Terms of Service</a></li>
              <li><a href="/disclaimer" class="hover:text-emerald-700 transition">Editorial Disclaimer</a></li>
            </ul>
          </div>

          <!-- Col 4: Human Editorial & Admin -->
          <div>
            <h4 class="font-semibold text-slate-900 text-sm mb-3">Editorial Oversight</h4>
            <p class="text-xs text-slate-500 mb-3">
              Every stipend, eligibility rule, and deadline is manually confirmed by human career leads prior to publication.
            </p>
            <div class="space-y-1 text-xs">
              <a href="/authors/hamza-tariq" class="text-emerald-700 font-medium hover:underline block">Meet Author Hamza Tariq →</a>
              <a href="/admin/adsense-check" class="text-slate-400 hover:text-slate-600 block mt-2">AdSense Compliance Audit</a>
            </div>
          </div>
        </div>

        <div class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>© {new Date().getFullYear()} PakInternships. All published listings remain subject to employer terms. Not affiliated with government bodies.</p>
          <div class="flex items-center gap-4">
            <a href="/sitemap.xml" class="hover:underline">XML Sitemap</a>
            <span>•</span>
            <a href="/robots.txt" class="hover:underline">Robots.txt</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
