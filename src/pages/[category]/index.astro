---
// ==============================================================================
// src/pages/[category]/index.astro
// Category Listing Page (Section 10: 150+ words unique editorial, noindex if < 3)
// ==============================================================================

import Layout from '../../layouts/Layout.astro';
import { getPublishedListings } from '../../lib/supabase';
import type { Listing } from '../../types/portal';

export async function getStaticPaths() {
  const published = await getPublishedListings();
  const categories = [
    {
      slug: 'computer-science',
      title: 'Computer Science & Software Engineering Opportunities',
      editorial: `
        The Pakistani software industry continues to expand rapidly, with domestic IT exports and regional product studios actively recruiting computer science and software engineering undergraduates. On this page, we curate verified, paid internships and entry-level junior developer positions across Lahore, Karachi, Islamabad, and remote teams in Pakistan.
        Our editorial team fact-checks every single vacancy by cross-referencing employer postings, human resource announcements, and public university placement notices. We explicitly verify compensation scales, ensuring students never waste their academic preparation on ambiguous or unpaid listings masquerading as professional experience.
        Whether your core competencies lie in full-stack web development, backend microservices, mobile app development (Flutter/React Native), or automated software quality assurance, every opportunity listed below includes confirmed eligibility criteria and transparent technical requirements.
      `.trim(),
    },
    {
      slug: 'engineering',
      title: 'Electrical, Mechanical & Robotics Engineering Opportunities',
      editorial: `
        Graduating engineers in Pakistan face unique challenges transitioning from theoretical academic coursework to industrial application. Our engineering track gathers verified opportunities within Pakistan's premier public defense research programs, heavy industrial complexes, telecommunications carriers, and renewable power utilities.
        We review and confirm postings across electrical power distribution, embedded systems firmware engineering, mechatronics robotics prototypes, and mechanical structural testing. Each entry outlines explicit minimum CGPA requirements, eligible engineering disciplines accredited by the Pakistan Engineering Council (PEC), and confirmed monthly stipends.
        By ensuring that only active, legitimate employer portals are featured, Pakistani engineering undergraduates can strategically plan their semester break internships and post-graduate trainee engineer applications with complete factual confidence.
      `.trim(),
    },
    {
      slug: 'information-technology',
      title: 'Cloud, DevOps & Network Security Opportunities',
      editorial: `
        Infrastructure operations, cloud engineering, and cybersecurity represent some of the highest-demand technical careers in Pakistan's enterprise tech landscape. This section focuses on verified traineeships and junior infrastructure roles spanning Linux system administration, AWS/GCP cloud operations, container orchestration, and network security monitoring.
        Every listed role is vetted by our senior career leads to confirm the validity of remote eligibility within Pakistan or physical NOC attendance in metropolitan centers like Islamabad, Rawalpindi, and Karachi.
        Candidates preparing for careers in Site Reliability Engineering (SRE), Network Operations Center (NOC) shifts, or CI/CD DevOps pipelines will find explicit breakdowns of required tools, technical certifications, and direct links to official employer career portals.
      `.trim(),
    },
  ];

  return categories.map((cat) => {
    const categoryListings = published.filter((l) => l.category === cat.slug);
    return {
      params: { category: cat.slug },
      props: {
        category: cat,
        listings: categoryListings,
      },
    };
  });
}

interface Props {
  category: {
    slug: string;
    title: string;
    editorial: string;
  };
  listings: Listing[];
}

const { category, listings } = Astro.props;

// Section 10 Rule: noindex if fewer than 3 listings!
const isThin = listings.length < 3;
const metaDescription = `Verified Engineering and IT opportunities in Pakistan for ${category.title}. Vetted stipends, deadlines, and prerequisites.`;
---

<Layout
  title={category.title}
  description={metaDescription}
  noindex={isThin}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-emerald-700">Home</a>
      <span>/</span>
      <span class="text-slate-800 capitalize font-medium">{category.slug.replace('-', ' ')}</span>
    </nav>

    <!-- Category Header & 150+ Word Unique Editorial Copy (Section 10) -->
    <header class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm mb-10">
      <div class="flex items-center gap-2 mb-3">
        <span class="text-xs uppercase tracking-wider font-bold text-emerald-800 bg-emerald-100 px-3 py-1 rounded-full">
          Curated Category Archive
        </span>
        <span class="text-xs text-slate-500 font-medium">
          {listings.length} Active {listings.length === 1 ? 'Opportunity' : 'Opportunities'}
        </span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        {category.title}
      </h1>

      <div class="prose prose-slate max-w-none text-slate-700 text-sm sm:text-base leading-relaxed">
        <p class="whitespace-pre-line">{category.editorial}</p>
      </div>

      {isThin && (
        <div class="mt-4 p-3 rounded-lg bg-amber-50 border border-amber-200 text-xs text-amber-900">
          <strong>Advisory:</strong> This category has fewer than 3 published listings and is automatically tagged with <code>noindex</code> to protect search indexing quality.
        </div>
      )}
    </header>

    <!-- Active Listings Grid (Open Only) -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-slate-900">Open Listings</h2>
        <span class="text-xs text-slate-500">Sorted by publication freshness</span>
      </div>

      {listings.length === 0 ? (
        <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center">
          <p class="text-slate-600 text-sm font-medium">No active open listings currently available in this track.</p>
          <p class="text-xs text-slate-400 mt-1">Our career leads review source postings daily. Check back shortly.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {listings.map((item) => (
            <article class="bg-white rounded-2xl border border-slate-200 hover:border-emerald-500 hover:shadow-lg transition p-6 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
                    {item.employment_type === 'INTERN' ? 'Internship' : 'Job'}
                  </span>
                  <span class="text-xs font-medium text-slate-500 uppercase">
                    {item.mode}
                  </span>
                </div>

                <h3 class="font-bold text-slate-900 text-base group-hover:text-emerald-700 transition leading-snug">
                  <a href={`/${item.category}/${item.slug}`}>
                    {item.title}
                  </a>
                </h3>

                <p class="text-xs font-medium text-slate-600 mt-1.5 flex items-center gap-1.5">
                  <span class="font-semibold text-slate-800">{item.company}</span>
                  <span>•</span>
                  <span>{item.location}</span>
                </p>

                <p class="text-xs text-slate-500 mt-3 line-clamp-3 leading-relaxed">
                  {item.intro}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-slate-100">
                <div class="flex items-center justify-between text-xs">
                  <div>
                    <span class="block text-[10px] text-slate-400 font-semibold uppercase">Stipend / Salary</span>
                    <span class="font-bold text-emerald-800">{item.stipend || 'View Details'}</span>
                  </div>
                  <div class="text-right">
                    <span class="block text-[10px] text-slate-400 font-semibold uppercase">Deadline</span>
                    <span class="font-medium text-slate-700">
                      {item.deadline ? new Date(item.deadline).toLocaleDateString('en-PK', { day: 'numeric', month: 'short' }) : 'Rolling'}
                    </span>
                  </div>
                </div>

                <a
                  href={`/${item.category}/${item.slug}`}
                  class="mt-4 block w-full py-2.5 px-4 text-center rounded-xl bg-slate-900 text-white font-semibold text-xs hover:bg-emerald-700 transition"
                >
                  View Details & Eligibility →
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  </div>
</Layout>
