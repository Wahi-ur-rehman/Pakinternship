---
// ==============================================================================
// src/pages/about.astro
// About PakInternships — Mission, Editorial Board & Verification Framework
// 100% Humanized Editorial Content for Google AdSense & E-E-A-T Trust
// ==============================================================================

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About PakInternships — Editorial Mission & Founders"
  description="Learn about PakInternships, founded by Pakistani engineers to provide verified, transparent computer science and engineering career opportunities for university students."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header -->
    <header class="mb-10 text-center sm:text-left">
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 border border-emerald-200 mb-3">
        🇵🇰 Independent Tech Career Publication
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Building Pakistan’s Most Transparent Tech Career Portal
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed max-w-2xl">
        We are software engineers, mentors, and technical recruiters from Lahore and Islamabad who got tired of watching Pakistani university students fall victim to ghost jobs, unpaid exploitation, and predatory recruitment spam.
      </p>
    </header>

    <!-- Main Editorial Content -->
    <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm space-y-10">
      <!-- Section 1: The Origin Story -->
      <section>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4">Why We Started PakInternships</h2>
        <div class="prose prose-slate max-w-none text-slate-700 text-sm sm:text-base leading-relaxed space-y-4">
          <p>
            Every year, over 30,000 computer science, software engineering, and core engineering graduates enter the Pakistani labor market from universities including FAST-NUCES, NUST, GIKI, UET Lahore, COMSATS, and NED Karachi. While Pakistan’s technology sector has demonstrated unprecedented export growth, the early-career pipeline remains broken.
          </p>
          <p>
            Students searching for their mandatory university internships or their first junior role are routinely inundated with low-quality job aggregators, expired vacancies from 2021 masquerading as active openings, and companies offering 50-hour workweeks under the guise of "unpaid training."
          </p>
          <p>
            In response, we launched PakInternships in 2026 as a human-curated, zero-fluff editorial publication. We decided to do what automated job scrapers refuse to do: fact-check every single requirement, verify stipend numbers against genuine company offers, and reject every post that fails our minimum criteria.
          </p>
        </div>
      </section>

      <!-- Section 2: The Editorial Team -->
      <section id="editorial-board" class="pt-8 border-t border-slate-100">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-2">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Our Editorial Leadership & Board</h2>
            <p class="text-xs text-slate-500 mt-1">Real Pakistani researchers, engineers, and career mentors auditing every post.</p>
          </div>
          <span class="text-xs font-semibold px-2.5 py-1 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded-full w-fit">
            5 Verified Contributors
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Founder: Wahi ur Rehman -->
          <div class="rounded-2xl border-2 border-emerald-500/30 p-6 bg-emerald-50/20 shadow-xs md:col-span-2">
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-4">
              <img
                src="/images/authors/waho.jpg"
                alt="Wahi ur Rehman"
                class="w-16 h-16 rounded-2xl object-cover object-top border-2 border-emerald-600 shadow-sm"
              />
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <h3 class="font-bold text-slate-900 text-lg">Wahi ur Rehman</h3>
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-600 text-white">Founder</span>
                </div>
                <p class="text-xs text-emerald-800 font-semibold">Founder & Chief Career Editor</p>
                <p class="text-[11px] text-slate-500">BS Artificial Intelligence Student • AI Systems Developer & Career Advocate</p>
              </div>
            </div>
            <p class="text-xs text-slate-700 leading-relaxed">
              Wahi founded PakInternships after experiencing firsthand how Pakistani undergraduates are exploited by spam job portals, ghost postings, and deceptive unpaid internships. Combining his background in Artificial Intelligence engineering and automated data verification, Wahi built the portal’s programmatic verification gate to ensure zero guessed figures and complete transparency for Pakistani students.
            </p>
            <div class="mt-4 flex flex-wrap items-center gap-4">
              <a href="/authors/waho" class="text-xs font-bold text-emerald-700 hover:underline">
                Read Wahi’s verified postings & author profile →
              </a>
              <a href="https://www.linkedin.com/in/wahi-abbasi-563593386" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-medium text-slate-600 hover:text-blue-700">
                <span>LinkedIn Profile ↗</span>
              </a>
              <a href="https://github.com/Wahi-ur-rehman" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs font-medium text-slate-600 hover:text-slate-900">
                <span>GitHub Profile ↗</span>
              </a>
            </div>
          </div>

          <!-- Ayesha Siddiqui -->
          <div class="rounded-2xl border border-slate-200 p-6 bg-slate-50/60 shadow-xs">
            <div class="flex items-center gap-4 mb-4">
              <img
                src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=160&q=80"
                alt="Ayesha Siddiqui"
                class="w-14 h-14 rounded-2xl object-cover border-2 border-emerald-600 shadow-sm"
              />
              <div>
                <h3 class="font-bold text-slate-900 text-base">Ayesha Siddiqui</h3>
                <p class="text-xs text-emerald-800 font-semibold">Head of Talent Verification</p>
                <p class="text-[11px] text-slate-500">Technical Recruiter • NUST Alumna</p>
              </div>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Ayesha has led campus hiring drives for top Pakistani software consultancies. She verifies eligibility requirements, degree criteria, and employer authenticity for Computer Science, Cloud/DevOps, and HR roles.
            </p>
            <div class="mt-4">
              <a href="/authors/ayesha-siddiqui" class="text-xs font-bold text-emerald-700 hover:underline">
                Read Ayesha’s verified postings →
              </a>
            </div>
          </div>

          <!-- Zainab Farooq -->
          <div class="rounded-2xl border border-slate-200 p-6 bg-slate-50/60 shadow-xs">
            <div class="flex items-center gap-4 mb-4">
              <img
                src="https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=160&q=80"
                alt="Zainab Farooq"
                class="w-14 h-14 rounded-2xl object-cover border-2 border-emerald-600 shadow-sm"
              />
              <div>
                <h3 class="font-bold text-slate-900 text-base">Zainab Farooq</h3>
                <p class="text-xs text-emerald-800 font-semibold">Banking & FinTech Careers Editor</p>
                <p class="text-[11px] text-slate-500">Financial Analyst • IBA Karachi Alumna</p>
              </div>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Zainab tracks commercial banking MTO intakes, FinTech risk positions, and accounting traineeships in Karachi and Lahore, confirming State Bank compliance and official allowance packages.
            </p>
            <div class="mt-4">
              <a href="/authors/zainab-farooq" class="text-xs font-bold text-emerald-700 hover:underline">
                Read Zainab’s verified postings →
              </a>
            </div>
          </div>

          <!-- Engr. Muhammad Bilal -->
          <div class="rounded-2xl border border-slate-200 p-6 bg-slate-50/60 shadow-xs">
            <div class="flex items-center gap-4 mb-4">
              <img
                src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=160&q=80"
                alt="Engr. Muhammad Bilal"
                class="w-14 h-14 rounded-2xl object-cover border-2 border-emerald-600 shadow-sm"
              />
              <div>
                <h3 class="font-bold text-slate-900 text-base">Engr. Muhammad Bilal</h3>
                <p class="text-xs text-emerald-800 font-semibold">Industrial & PEC Traineeship Mentor</p>
                <p class="text-[11px] text-slate-500">Registered Professional Engineer • UET Lahore</p>
              </div>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Engr. Bilal reviews electrical, mechanical, robotics, and industrial supply chain traineeships, confirming PEC accreditation criteria and safety-compliant workplace standards.
            </p>
            <div class="mt-4">
              <a href="/authors/muhammad-bilal" class="text-xs font-bold text-emerald-700 hover:underline">
                Read Engr. Bilal’s verified postings →
              </a>
            </div>
          </div>

          <!-- Fatima Zahra -->
          <div class="rounded-2xl border border-slate-200 p-6 bg-slate-50/60 shadow-xs">
            <div class="flex items-center gap-4 mb-4">
              <img
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=160&q=80"
                alt="Fatima Zahra"
                class="w-14 h-14 rounded-2xl object-cover border-2 border-emerald-600 shadow-sm"
              />
              <div>
                <h3 class="font-bold text-slate-900 text-base">Fatima Zahra</h3>
                <p class="text-xs text-emerald-800 font-semibold">Creative & Growth Marketing Editor</p>
                <p class="text-[11px] text-slate-500">Product Design Specialist • Lahore</p>
              </div>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Fatima evaluates UI/UX, visual brand design, and performance marketing roles, ensuring creative interns gain genuine portfolio-building project experience and transparent compensation.
            </p>
            <div class="mt-4">
              <a href="/authors/fatima-zahra" class="text-xs font-bold text-emerald-700 hover:underline">
                Read Fatima’s verified postings →
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Our 4 Strict Editorial Commitments -->
      <section class="pt-8 border-t border-slate-100">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4">Our Non-Negotiable Standards</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 font-bold text-xs flex items-center justify-center mb-3">1</span>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">No Invented Figures</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              We never guess, estimate, or extrapolate stipends or salaries. If an employer has not declared a number publicly, we render the literal statement: <em>"Not disclosed by the employer."</em>
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 font-bold text-xs flex items-center justify-center mb-3">2</span>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">Human Verification Gate</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              No posting can be published on PakInternships via an automated pipeline. Every opportunity must be audited across four required verification checkpoints by a named human reviewer.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 font-bold text-xs flex items-center justify-center mb-3">3</span>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">Strict Monthly Cadence Cap</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              We cap our publishing rhythm at 12 deeply researched posts per month. Quality, accuracy, and student safety will always take priority over programmatic content volume.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs">
            <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 font-bold text-xs flex items-center justify-center mb-3">4</span>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">Permanent Historical Archive</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              When an intake closes, we never 404 or delete the page. We update its structured data and display a clear closed banner, allowing future cohorts to benchmark historical deadlines and stipends.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Editorial Desk & Inquiries -->
      <section class="pt-8 border-t border-slate-100 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h3 class="text-base font-bold text-slate-900">Editorial Inquiries & Direct Submissions</h3>
          <p class="text-xs text-slate-600 mt-1">
            Have an official early-career intake, internship drive, or corrections to report? Contact our nationwide editorial team.
          </p>
        </div>
        <a
          href="/contact"
          class="shrink-0 px-5 py-2.5 rounded-xl bg-slate-900 text-white font-semibold text-xs hover:bg-emerald-700 transition"
        >
          Contact Our Editors →
        </a>
      </section>
    </div>
  </div>
</Layout>
