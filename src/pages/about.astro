---
// ==============================================================================
// src/pages/about.astro
// Trust Page: About Our Mission & Human Verification Framework
// ==============================================================================

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About Us — Mission & Editorial Standards"
  description="Learn about PakInternships mission to provide fact-checked, human-verified engineering and IT internships for Pakistani university students."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-4">
        About PakInternships
      </h1>
      <p class="text-xs uppercase tracking-wider font-semibold text-emerald-800 bg-emerald-50 inline-block px-3 py-1 rounded-full border border-emerald-200 mb-6">
        Student-First Engineering & IT Career Transparency
      </p>

      <!-- OWNER: REPLACE WITH HAND-WRITTEN COPY -->
      <div class="rounded-2xl border-2 border-dashed border-amber-300 bg-amber-50/70 p-6 my-6 text-amber-950">
        <h2 class="text-sm font-bold uppercase tracking-wide text-amber-900 mb-2">
          <!-- OWNER: REPLACE WITH HAND-WRITTEN COPY -->
        </h2>
        <p class="text-xs leading-relaxed">
          <strong>Site Owner Notice:</strong> Google AdSense reviewers specifically evaluate legal and about pages for authentic human authorship. Replace this block with your personal statement detailing your background, why you founded this portal for Pakistani engineering students, and how your team audits employer listings.
        </p>
      </div>

      <div class="prose prose-slate max-w-none text-slate-700 text-sm leading-relaxed space-y-4">
        <p>
          PakInternships was created to solve a persistent challenge in Pakistan's higher education ecosystem: the prevalence of outdated, ambiguous, and unverified internship listings that mislead early-career computer science and engineering undergraduates.
        </p>
        <p>
          Our team enforces a human-in-the-loop review pipeline. Before any listing receives public indexation, an accredited technical mentor confirms the compensation scale, deadline, academic requirements, and Pakistani national eligibility directly against the employer's official recruitment portal.
        </p>
      </div>
    </div>
  </div>
</Layout>
