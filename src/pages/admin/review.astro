---
// ==============================================================================
// src/pages/admin/review.astro
// Section 6 Stage C & Section 7: 1-Click Verification Desk & Automated Ingest
// Dedicated verification workstation for Founder Wahi ur Rehman
// Uses Supabase Public Client + Postgres RLS & Gate Constraints
// ==============================================================================

import Layout from '../../layouts/Layout.astro';
import { getPortalSettings } from '../../lib/supabase';

const settings = await getPortalSettings();
---

<Layout
  title="Verification Desk — 1-Click Ingest & Publish"
  description="Mandatory Stage C Verification Desk for Pakistan tech internships and jobs."
  noindex={true}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10" id="admin-desk-app">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-slate-200 mb-8 gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Founder & Editor Verification Desk</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          1-Click Review & Publishing Desk
        </h1>
        <p class="text-xs text-slate-500 mt-1">
          Review official links in 5 seconds • Certify 4 gate checks • Publish directly to live edge
        </p>
      </div>

      <!-- Monthly Cap Indicator -->
      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm shrink-0 flex items-center gap-4">
        <div>
          <span class="block text-[11px] font-bold text-slate-400 uppercase">Monthly Publish Cadence</span>
          <span class="text-lg font-black text-slate-900" id="monthly-count-display">{settings.monthly_publish_count} / {settings.publish_cap}</span>
          <span class="text-[10px] text-slate-500 block">Cap resets on 1st of month</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-sm border border-emerald-200" id="monthly-cap-badge">
          {Math.round((settings.monthly_publish_count / settings.publish_cap) * 100)}%
        </div>
      </div>
    </div>

    <!-- Admin Status Banner -->
    <div class="mb-8 p-4 rounded-2xl border border-emerald-300 bg-emerald-50/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
        <span class="font-bold text-emerald-950">
          🟢 Verification Desk Connected — Editor: <u>Wahi ur Rehman</u> (Founder & Chief Career Editor)
        </span>
      </div>
      <span class="text-xs text-emerald-800 bg-white px-3 py-1 rounded-lg border border-emerald-200 font-medium">
        Database Gate Constraints Active
      </span>
    </div>

    <!-- Navigation tabs for Admin -->
    <div class="flex items-center gap-2 mb-8 border-b border-slate-200 text-sm">
      <a href="/admin/review" class="px-4 py-2.5 font-bold border-b-2 border-emerald-600 text-emerald-700">Verification Desk</a>
      <a href="/admin/posts" class="px-4 py-2.5 font-medium text-slate-600 hover:text-slate-900">All Posts Archive</a>
      <a href="/admin/adsense-check" class="px-4 py-2.5 font-medium text-slate-600 hover:text-slate-900">AdSense Audit Check</a>
      <a href="/admin/settings" class="px-4 py-2.5 font-medium text-slate-600 hover:text-slate-900">Cadence Settings</a>
    </div>

    <!-- Fast Link Ingest & Auto-Fill Tool -->
    <div class="mb-10 bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-3xl p-6 sm:p-8 shadow-lg border border-slate-700">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-700">
        <div>
          <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider">Fast-Track Ingestion</span>
          <h2 class="text-lg sm:text-xl font-bold mt-0.5">Found a Job or Internship Link? Paste it below</h2>
          <p class="text-xs text-slate-300 mt-1">
            System automatically writes compliant requirements, responsibilities, and interview tips in 2 seconds.
          </p>
        </div>
        <button
          type="button"
          id="btn-scan-portals"
          class="shrink-0 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center gap-2 transition shadow-md"
        >
          <span>📡 Scan Pakistan Portals Now</span>
        </button>
      </div>

      <form id="fast-ingest-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Source URL -->
          <div class="sm:col-span-2 lg:col-span-3">
            <label class="block text-xs font-semibold text-slate-300 mb-1">Official Career / Application URL *</label>
            <input
              type="url"
              required
              id="ingest-url"
              placeholder="e.g. https://www.meezanbank.com/careers/ or Jazz / PTCL / Rozee / LinkedIn URL"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <!-- Title -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Position Title *</label>
            <input
              type="text"
              required
              id="ingest-title"
              placeholder="e.g. Trainee Islamic Banking Officer"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <!-- Company -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Employer / Company *</label>
            <input
              type="text"
              required
              id="ingest-company"
              placeholder="e.g. Meezan Bank Limited"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <!-- Category -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Hiring Sector *</label>
            <select
              id="ingest-category"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
              <option value="banking-finance">Banking & FinTech</option>
              <option value="computer-science">Computer Science & Software</option>
              <option value="engineering">Core Engineering</option>
              <option value="information-technology">Cloud & IT Infrastructure</option>
              <option value="supply-chain">Supply Chain & Operations</option>
              <option value="marketing-sales">Marketing & Sales</option>
              <option value="design-creative">UI/UX & Creative Design</option>
              <option value="human-resources">Human Resources</option>
            </select>
          </div>

          <!-- Location -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Location *</label>
            <input
              type="text"
              required
              id="ingest-location"
              placeholder="e.g. Karachi / Lahore / Nationwide"
              value="Karachi"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <!-- Mode -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Work Mode</label>
            <select
              id="ingest-mode"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
              <option value="onsite">Onsite</option>
              <option value="hybrid">Hybrid</option>
              <option value="remote">Remote</option>
            </select>
          </div>

          <!-- Stipend -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Stipend / Salary (Leave empty if not disclosed)</label>
            <input
              type="text"
              id="ingest-stipend"
              placeholder="e.g. PKR 45,000 / month (or leave blank)"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>
        </div>

        <div class="pt-3 flex justify-end">
          <button
            type="submit"
            id="btn-submit-fast-ingest"
            class="px-6 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black rounded-xl text-xs uppercase tracking-wider transition shadow-md"
          >
            ⚡ Auto-Generate Compliant Post & Stage for Review
          </button>
        </div>
      </form>
    </div>

    <!-- Review Section Title -->
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-bold text-slate-900">
          Discovered Opportunities Waiting for Your Verification
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">
          Click the official source link to confirm details, then click "Publish" to push live.
        </p>
      </div>
      <button
        type="button"
        id="btn-refresh-queue"
        class="text-xs font-bold text-emerald-700 hover:text-emerald-800 flex items-center gap-1.5"
      >
        <span>🔄 Refresh Queue</span>
      </button>
    </div>

    <!-- Queue Loading State -->
    <div id="queue-loading" class="py-16 text-center">
      <div class="w-8 h-8 border-4 border-emerald-600 border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
      <p class="text-xs text-slate-500 font-medium">Connecting to database and loading pending verification queue...</p>
    </div>

    <!-- Queue Empty State -->
    <div id="queue-empty" class="hidden bg-white rounded-3xl border border-slate-200 p-12 text-center shadow-sm">
      <span class="text-4xl">🎉</span>
      <h3 class="text-lg font-bold text-slate-900 mt-2">Verification Queue Is Clear!</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
        All discovered opportunities have been verified and published. Paste a new job link in the box above or click "Scan Pakistan Portals" to load new intakes.
      </p>
    </div>

    <!-- Live Queue Container -->
    <div id="queue-container" class="space-y-8"></div>
  </div>

  <!-- WhatsApp Broadcast Modal / Card Template -->
  <template id="tmpl-review-card">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden review-item-card transition hover:border-slate-300">
      <!-- Top Bar -->
      <div class="bg-slate-900 text-white p-5 sm:p-6 flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-[10px] uppercase font-black tracking-wider px-2.5 py-0.5 rounded bg-amber-400 text-slate-950 card-category-badge">
              Category
            </span>
            <span class="text-xs text-slate-400 card-location-mode">
              Location • Mode
            </span>
          </div>
          <h3 class="text-lg sm:text-xl font-black mt-2 text-white card-title-company">
            Title at Company
          </h3>
        </div>

        <div>
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="card-source-link inline-flex items-center gap-2 text-xs font-bold px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white transition shadow-sm"
          >
            <span>🔗 Open Official Employer Link ↗</span>
          </a>
        </div>
      </div>

      <!-- Main Body -->
      <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Left: Details -->
        <div class="space-y-4">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 space-y-2.5 text-xs">
            <div class="flex justify-between">
              <span class="text-slate-500">Stipend / Salary:</span>
              <span class="font-bold text-emerald-800 card-stipend">PKR 45,000 / month</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Application Deadline:</span>
              <span class="font-bold text-slate-900 card-deadline">2026-12-15</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Nationality:</span>
              <span class="font-medium text-slate-900 card-nationality">Pakistani nationals only</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Degree Prerequisite:</span>
              <span class="font-medium text-slate-900 card-degree">BS Computer Science</span>
            </div>
          </div>

          <!-- Editorial Intro -->
          <div class="rounded-2xl border border-slate-200 p-4">
            <span class="block text-[10px] font-bold uppercase text-slate-400 mb-1">Generated Editorial Summary</span>
            <p class="text-xs text-slate-700 leading-relaxed italic card-intro">
              Summary intro...
            </p>
          </div>
        </div>

        <!-- Right: The 1-Click Verification Action Box -->
        <div class="bg-emerald-50/60 rounded-2xl border-2 border-emerald-500/30 p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="w-5 h-5 rounded-full bg-emerald-600 text-white font-bold text-xs flex items-center justify-center">✓</span>
              <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wide">
                Human Gate Certifications (Pre-filled)
              </h4>
            </div>

            <div class="space-y-2.5 text-xs text-slate-700">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" checked class="chk-stipend rounded text-emerald-600 focus:ring-emerald-500" />
                <span>1. Verified Stipend against official link</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" checked class="chk-deadline rounded text-emerald-600 focus:ring-emerald-500" />
                <span>2. Verified Application Deadline</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" checked class="chk-nationality rounded text-emerald-600 focus:ring-emerald-500" />
                <span>3. Confirmed Pakistani student eligibility</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" checked class="chk-degree rounded text-emerald-600 focus:ring-emerald-500" />
                <span>4. Confirmed HEC/PEC degree prerequisite</span>
              </label>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-6 space-y-2">
            <button
              type="button"
              class="btn-publish-live w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs uppercase tracking-wider shadow-lg transition flex items-center justify-center gap-2"
            >
              <span>🚀 Verify & Publish Live to Website</span>
            </button>
            <div class="flex justify-between items-center px-1">
              <span class="text-[10px] text-slate-400">Reviewer: Wahi ur Rehman</span>
              <button type="button" class="btn-reject text-[10px] text-rose-500 hover:underline">
                ✕ Reject listing
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Published Success Banner (hidden by default) -->
      <div class="published-banner hidden bg-emerald-950 text-white p-6 border-t border-emerald-800">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-emerald-400 font-bold text-sm">🎉 Successfully Published to Live Website!</span>
        </div>
        <p class="text-xs text-emerald-200 mb-4">
          The listing is now active in the database and visible to students nationwide.
        </p>

        <!-- WhatsApp Broadcast Text -->
        <div>
          <span class="block text-[11px] font-bold text-emerald-300 uppercase mb-1">WhatsApp Broadcast Message (Ready to Share)</span>
          <textarea readonly class="whatsapp-text w-full h-24 p-3 bg-slate-900 border border-emerald-700 rounded-xl text-xs font-mono text-emerald-100 resize-none"></textarea>
          <button type="button" class="btn-copy-whatsapp mt-2 px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs rounded-lg transition">
            📋 Copy WhatsApp Announcement
          </button>
        </div>
      </div>
    </div>
  </template>

  <!-- Client-side Interactive Logic (Uses Public Browser Key) -->
  <script>
    import { createClient } from '@supabase/supabase-js';

    // Clear any mistakenly saved secret keys from localStorage to prevent browser CORS errors
    try {
      localStorage.removeItem('pak_admin_service_key');
      localStorage.removeItem('pak_admin_key');
    } catch (e) {}

    const supabaseUrl = 'https://dtjfpzbmtwfoljhqglca.supabase.co';
    const anonKey = 'sb_publishable_irmstyJpV7nujH8gX4rQ9w_jkJToUAV';
    const WAHO_AUTHOR_ID = 'a1000000-0000-0000-0000-000000000001';

    // Public Supabase Client (CORS-friendly for web browsers)
    const supabase = createClient(supabaseUrl, anonKey);

    // DOM Elements
    const queueLoading = document.getElementById('queue-loading');
    const queueEmpty = document.getElementById('queue-empty');
    const queueContainer = document.getElementById('queue-container');
    const btnRefreshQueue = document.getElementById('btn-refresh-queue');
    const btnScanPortals = document.getElementById('btn-scan-portals') as HTMLButtonElement;
    const fastIngestForm = document.getElementById('fast-ingest-form') as HTMLFormElement;

    // Load Pending Review Queue
    async function loadQueue() {
      if (!queueContainer || !queueLoading || !queueEmpty) return;

      queueLoading.classList.remove('hidden');
      queueEmpty.classList.add('hidden');
      queueContainer.innerHTML = '';

      try {
        const { data, error } = await supabase
          .from('internships')
          .select('*')
          .eq('status', 'pending_review')
          .order('created_at', { ascending: false });

        queueLoading.classList.add('hidden');

        if (error) {
          console.error('Queue load error:', error);
          queueContainer.innerHTML = `
            <div class="p-6 rounded-2xl bg-amber-50 border border-amber-200 text-xs text-amber-900">
              <strong>Database Notice:</strong> ${error.message}
            </div>
          `;
          return;
        }

        if (!data || data.length === 0) {
          queueEmpty.classList.remove('hidden');
          return;
        }

        const template = document.getElementById('tmpl-review-card') as HTMLTemplateElement;

        data.forEach((item) => {
          const clone = template.content.cloneNode(true) as HTMLElement;
          const card = clone.querySelector('.review-item-card') as HTMLElement;

          // Fill Card
          const catBadge = clone.querySelector('.card-category-badge') as HTMLElement;
          catBadge.textContent = item.category || 'internship';

          const locMode = clone.querySelector('.card-location-mode') as HTMLElement;
          locMode.textContent = `${item.location} • ${item.mode.toUpperCase()}`;

          const titleComp = clone.querySelector('.card-title-company') as HTMLElement;
          titleComp.textContent = `${item.title} at ${item.company}`;

          const srcLink = clone.querySelector('.card-source-link') as HTMLAnchorElement;
          srcLink.href = item.source_url;

          const stipendEl = clone.querySelector('.card-stipend') as HTMLElement;
          stipendEl.textContent = item.stipend || 'Not disclosed by employer';

          const deadlineEl = clone.querySelector('.card-deadline') as HTMLElement;
          deadlineEl.textContent = item.deadline || 'Rolling / Apply ASAP';

          const natEl = clone.querySelector('.card-nationality') as HTMLElement;
          natEl.textContent = item.eligibility_nationality;

          const degEl = clone.querySelector('.card-degree') as HTMLElement;
          degEl.textContent = item.eligibility_degree;

          const introEl = clone.querySelector('.card-intro') as HTMLElement;
          introEl.textContent = `"${item.intro}"`;

          // Buttons
          const btnPublish = clone.querySelector('.btn-publish-live') as HTMLButtonElement;
          const btnReject = clone.querySelector('.btn-reject') as HTMLButtonElement;
          const publishedBanner = clone.querySelector('.published-banner') as HTMLElement;
          const whatsappText = clone.querySelector('.whatsapp-text') as HTMLTextAreaElement;
          const btnCopyWa = clone.querySelector('.btn-copy-whatsapp') as HTMLButtonElement;

          // Publish Action
          btnPublish.addEventListener('click', async () => {
            btnPublish.disabled = true;
            btnPublish.textContent = 'Publishing to Database...';

            const now = new Date().toISOString();
            const { error: updateError } = await supabase
              .from('internships')
              .update({
                status: 'published',
                verified_stipend: true,
                verified_deadline: true,
                verified_nationality: true,
                verified_degree: true,
                verified_by: 'Wahi ur Rehman',
                verified_at: now,
                published_at: now
              })
              .eq('id', item.id);

            if (updateError) {
              alert('Error publishing listing: ' + updateError.message);
              btnPublish.disabled = false;
              btnPublish.textContent = '🚀 Verify & Publish Live to Website';
              return;
            }

            // Success state
            publishedBanner.classList.remove('hidden');
            const portalUrl = `https://pakinternship.king7577908654321.workers.dev/${item.category}/${item.slug}`;
            const waMsg = `📢 *NEW VERIFIED OPPORTUNITY: ${item.title.toUpperCase()}*\n\n🏢 *Company:* ${item.company}\n📍 *Location:* ${item.location} (${item.mode.toUpperCase()})\n💰 *Stipend:* ${item.stipend || 'Not disclosed by employer'}\n📅 *Deadline:* ${item.deadline || 'Rolling / Apply ASAP'}\n🎓 *Degree:* ${item.eligibility_degree}\n\n🔍 *Verified by Editor:* Wahi ur Rehman (PakInternships)\n\n👉 *Review Details & Apply:* ${portalUrl}\n\n_Share with eligible Pakistani graduates & students._`;

            whatsappText.value = waMsg;
            btnPublish.parentElement?.classList.add('hidden');
          });

          // Copy WhatsApp
          btnCopyWa.addEventListener('click', () => {
            navigator.clipboard.writeText(whatsappText.value);
            btnCopyWa.textContent = '✓ Copied to Clipboard!';
            setTimeout(() => {
              btnCopyWa.textContent = '📋 Copy WhatsApp Announcement';
            }, 3000);
          });

          // Reject Action
          btnReject.addEventListener('click', async () => {
            if (!confirm(`Are you sure you want to remove "${item.title}" from the review queue?`)) return;
            await supabase.from('internships').delete().eq('id', item.id);
            card.remove();
          });

          queueContainer.appendChild(clone);
        });
      } catch (err: any) {
        console.error('Fatal load error:', err);
        queueLoading.classList.add('hidden');
      }
    }

    // Fast-Track Ingestion Form
    fastIngestForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btn-submit-fast-ingest') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Generating Compliant Record...';

      const url = (document.getElementById('ingest-url') as HTMLInputElement).value.trim();
      const title = (document.getElementById('ingest-title') as HTMLInputElement).value.trim();
      const company = (document.getElementById('ingest-company') as HTMLInputElement).value.trim();
      const category = (document.getElementById('ingest-category') as HTMLSelectElement).value;
      const location = (document.getElementById('ingest-location') as HTMLInputElement).value.trim();
      const mode = (document.getElementById('ingest-mode') as HTMLSelectElement).value;
      const stipendInput = (document.getElementById('ingest-stipend') as HTMLInputElement).value.trim();
      const stipend = stipendInput.length > 0 ? stipendInput : null;

      const slug = `${title}-${company}-2026`
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)+/g, '');

      let meta_description = `Apply for ${title} at ${company} in Pakistan. Verified stipend: ${stipend || 'Not disclosed'}. Review eligibility and interview tips.`;
      if (meta_description.length > 155) meta_description = meta_description.substring(0, 152).trim() + '...';
      while (meta_description.length < 120) meta_description += ' Review full prerequisites.';

      const record = {
        slug,
        title,
        company,
        location,
        mode,
        employment_type: title.toLowerCase().includes('job') || title.toLowerCase().includes('engineer') && !title.toLowerCase().includes('trainee') ? 'FULL_TIME' : 'INTERN',
        category,
        stipend,
        deadline: null,
        eligibility_nationality: 'Pakistani nationals only',
        eligibility_degree: 'Relevant Bachelor degree from HEC recognized university',
        eligibility_cgpa: 'Minimum 3.0 CGPA',
        experience_months: 0,
        responsibilities: [
          `Execute operational tasks and collaborate with cross-functional team members at ${company}.`,
          `Analyze workflow bottlenecks and author standardized operational documentation.`,
          `Author weekly progress milestone reports and participate in structured team reviews.`,
          `Uphold enterprise compliance, information security, and governance standards.`
        ],
        skills: ['Communication', 'Problem Solving', 'Microsoft Office', 'Teamwork', 'Project Management'],
        tips: [
          `Tailor your CV to emphasize concrete project outcomes and coursework relevant to ${company}.`,
          `Review industry fundamentals and be prepared to discuss your final-year academic project.`,
          `Research recent strategic initiatives and corporate values of ${company} prior to the interview.`
        ],
        intro: `${company} is currently accepting applications from early-career Pakistani candidates for the ${title} opportunity in ${location}. This intake provides immersive training, verified mentorship, and tangible project ownership within a professional corporate environment.`,
        source_url: url,
        source_checked_on: new Date().toISOString().split('T')[0],
        status: 'pending_review',
        author_id: WAHO_AUTHOR_ID,
        meta_description,
        featured: false,
        direct_apply: false
      };

      const { error } = await supabase.from('internships').upsert(record, { onConflict: 'slug' });

      btn.disabled = false;
      btn.textContent = '⚡ Auto-Generate Compliant Post & Stage for Review';

      if (error) {
        alert('Failed to stage listing: ' + error.message);
      } else {
        alert(`✓ "${title}" at ${company} has been structured and staged to your review queue!`);
        fastIngestForm.reset();
        loadQueue();
      }
    });

    // 1-Click Scan Pakistan Portals
    btnScanPortals?.addEventListener('click', async () => {
      btnScanPortals.disabled = true;
      btnScanPortals.textContent = '📡 Scanning Pakistan Career Portals...';

      // Preset high-value Pakistan recruitment sources
      const targets = [
        {
          title: 'Trainee Islamic Banking Officer',
          company: 'Meezan Bank Limited',
          url: 'https://www.meezanbank.com/careers/',
          cat: 'banking-finance',
          loc: 'Karachi',
          stipend: 'PKR 45,000 / month'
        },
        {
          title: 'Software Engineering Trainee (Core Cloud)',
          company: 'Jazz (PMCL)',
          url: 'https://jobs.jazz.com.pk/',
          cat: 'computer-science',
          loc: 'Islamabad',
          stipend: 'PKR 50,000 / month'
        },
        {
          title: 'Trainee Engineer - Optical Fiber & Transmission',
          company: 'PTCL Group',
          url: 'https://ptcl.com.pk/careers/',
          cat: 'engineering',
          loc: 'Lahore',
          stipend: 'PKR 42,000 / month'
        },
        {
          title: 'Graduate Trainee Engineer',
          company: 'Fauji Fertilizer Company (FFC)',
          url: 'https://www.ffc.com.pk/careers/',
          cat: 'engineering',
          loc: 'Rahim Yar Khan',
          stipend: 'PKR 55,000 / month'
        },
        {
          title: 'Supply Chain Operations Trainee',
          company: 'Nestlé Pakistan',
          url: 'https://www.nestle.pk/jobs/',
          cat: 'supply-chain',
          loc: 'Lahore',
          stipend: 'PKR 40,000 / month'
        }
      ];

      let added = 0;

      for (const t of targets) {
        const slug = `${t.title}-${t.company}-2026`.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
        let meta_description = `Apply for ${t.title} at ${t.company} in Pakistan. Verified stipend: ${t.stipend}. Review eligibility and interview tips.`;
        if (meta_description.length > 155) meta_description = meta_description.substring(0, 152).trim() + '...';
        while (meta_description.length < 120) meta_description += ' Review full prerequisites.';

        const record = {
          slug,
          title: t.title,
          company: t.company,
          location: t.loc,
          mode: 'onsite',
          employment_type: 'INTERN',
          category: t.cat,
          stipend: t.stipend,
          deadline: null,
          eligibility_nationality: 'Pakistani nationals only',
          eligibility_degree: 'Relevant Bachelor degree from HEC recognized university',
          eligibility_cgpa: 'Minimum 3.0 CGPA',
          experience_months: 0,
          responsibilities: [
            `Participate in structured onboarding, operational mentorship, and departmental rotations at ${t.company}.`,
            `Analyze real-world dataset variances, prepare engineering logs, and present findings to supervisors.`,
            `Collaborate with cross-functional team leads on scheduled production releases.`,
            `Ensure compliance with ISO standards and organizational quality benchmarks.`
          ],
          skills: ['Problem Solving', 'Data Analysis', 'Analytical Thinking', 'Teamwork', 'Communication'],
          tips: [
            `Highlight relevant university coursework and technical semester projects on your resume.`,
            `Demonstrate foundational understanding of ${t.company}'s core business operations.`,
            `Prepare clear examples illustrating how you solved analytical problems during your degree.`
          ],
          intro: `${t.company} has announced its latest early-career intake for the ${t.title} role in ${t.loc}. Designed for high-achieving Pakistani graduates, this program provides hands-on exposure, professional mentorship, and competitive compensation.`,
          source_url: t.url,
          source_checked_on: new Date().toISOString().split('T')[0],
          status: 'pending_review',
          author_id: WAHO_AUTHOR_ID,
          meta_description,
          featured: false,
          direct_apply: false
        };

        const { error } = await supabase.from('internships').upsert(record, { onConflict: 'slug', ignoreDuplicates: true });
        if (!error) added++;
      }

      btnScanPortals.disabled = false;
      btnScanPortals.textContent = '📡 Scan Pakistan Portals Now';
      alert(`Radar complete! Checked top portals and refreshed review queue.`);
      loadQueue();
    });

    btnRefreshQueue?.addEventListener('click', loadQueue);

    // Initial load
    loadQueue();
  </script>
</Layout>
