            publishedBanner.classList.remove('hidden');
            const portalUrl = `https://pakinternship.king7577908654321.workers.dev/${item.category}/${item.slug}`;
            const compLabel = item.salary_min ? `PKR ${item.salary_min.toLocaleString()} - PKR ${item.salary_max.toLocaleString()}/mo` : (item.stipend || 'Disclosed on application');
            const waMsg = `📢 *NEW VERIFIED OPPORTUNITY: ${item.title.toUpperCase()}*\n\n🏢 *Company:* ${item.company}\n📍 *Location:* ${item.location} (${item.mode.toUpperCase()})\n💼 *Type:* ${item.employment_type === 'FULL_TIME' ? 'Full-Time Job' : 'Internship / Trainee'}\n💰 *Compensation:* ${compLabel}\n📅 *Deadline:* ${item.deadline || 'Rolling / Apply ASAP'}\n🎓 *Degree:* ${item.eligibility_degree}\n\n🔍 *Verified by Editor:* Wahi ur Rehman (PakInternships)\n\n👉 *Review Details & Apply:* ${portalUrl}\n\n_Share with eligible Pakistani candidates._`;

            whatsappText.value = waMsg;
            btnPublish.parentElement?.classList.add('hidden');
          });

          // Copy WhatsApp
          btnCopyWa.addEventListener('click', () => {
            navigator.clipboard.writeText(whatsappText.value);
            btnCopyWa.textContent = '✓ Copied to Clipboard!';
            setTimeout(() => {
              btnCopyWa.textContent = '📋 Copy WhatsApp Announcement';
            }, 3000);
          });

          // Reject Action
          btnReject.addEventListener('click', async () => {
            if (!confirm(`Are you sure you want to remove "${item.title}" from the review queue?`)) return;
            await supabase.from('internships').delete().eq('id', item.id);
            card.remove();
          });

          queueContainer.appendChild(clone);
        });
      } catch (err: any) {
        console.error('Fatal load error:', err);
        queueLoading.classList.add('hidden');
      }
    }

