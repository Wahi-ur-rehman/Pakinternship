---
// ==============================================================================
// src/pages/admin/review.astro
// Section 6 Stage C & Section 7: 1-Click Verification Desk & Automated Ingest
// Comprehensive Nationwide Pakistan Radar:
// Startups, Software Houses, Banks, Enterprises, Engineering, FMCG & Social Media
// Dedicated verification workstation for Founder Wahi ur Rehman
// ==============================================================================

import Layout from '../../layouts/Layout.astro';
import { getPortalSettings } from '../../lib/supabase';

const settings = await getPortalSettings();
---

<Layout
  title="Verification Desk — Pakistan Jobs, Internships & Social Feeds"
  description="Verification Desk for Pakistan tech startups, software houses, banks, enterprises & social hiring."
  noindex={true}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10" id="admin-desk-app">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-slate-200 mb-8 gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Nationwide Pakistan Career Radar</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Pakistan Jobs, Startups & Social Hiring Desk
        </h1>
        <p class="text-xs text-slate-500 mt-1">
          Startups • Software Houses • Banks • Engineering • Instagram & Facebook Posts • 1-Click Verify & Publish
        </p>
      </div>

      <!-- Monthly Cap Indicator -->
      <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm shrink-0 flex items-center gap-4">
        <div>
          <span class="block text-[11px] font-bold text-slate-400 uppercase">Monthly Publish Cadence</span>
          <span class="text-lg font-black text-slate-900" id="monthly-count-display">{settings.monthly_publish_count} / {settings.publish_cap}</span>
          <span class="text-[10px] text-slate-500 block">Cap resets on 1st of month</span>
        </div>
        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-sm border border-emerald-200" id="monthly-cap-badge">
          {Math.round((settings.monthly_publish_count / settings.publish_cap) * 100)}%
        </div>
      </div>
    </div>

    <!-- Active Reviewer Banner -->
    <div class="mb-8 p-4 rounded-2xl border border-emerald-300 bg-emerald-50/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
        <span class="font-bold text-emerald-950">
          🟢 Verification Session Active — Signed in as <u>Wahi ur Rehman</u> (Founder & Chief Career Editor)
        </span>
      </div>
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-[11px] font-medium text-emerald-800 bg-white px-2.5 py-1 rounded-lg border border-emerald-200">
          Startups • Software Houses • Enterprises • Social Feeds
        </span>
      </div>
    </div>

    <!-- Navigation tabs for Admin -->
    <div class="flex items-center gap-2 mb-8 border-b border-slate-200 text-sm">
      <a href="/admin/review" class="px-4 py-2.5 font-bold border-b-2 border-emerald-600 text-emerald-700">Verification Desk</a>
      <a href="/admin/posts" class="px-4 py-2.5 font-medium text-slate-600 hover:text-slate-900">All Posts Archive</a>
      <a href="/admin/adsense-check" class="px-4 py-2.5 font-medium text-slate-600 hover:text-slate-900">AdSense Audit Check</a>
      <a href="/admin/settings" class="px-4 py-2.5 font-medium text-slate-600 hover:text-slate-900">Cadence Settings</a>
    </div>

    <!-- Multi-Channel Ingestion & Radar Card -->
    <div class="mb-10 bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-3xl p-6 sm:p-8 shadow-lg border border-slate-700">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-700">
        <div>
          <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider">Automated Pakistan Career Radar</span>
          <h2 class="text-lg sm:text-xl font-bold mt-0.5">Ingest from Any Company or Social Media Post</h2>
          <p class="text-xs text-slate-300 mt-1">
            Scan top startups, software houses, enterprises, and Facebook/Instagram hiring flyers in 1 click.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            id="btn-scan-portals"
            class="shrink-0 px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black text-xs flex items-center gap-2 transition shadow-md"
          >
            <span>📡 Scan 25+ Pakistan Targets (Startups, Banks, Tech & Social)</span>
          </button>
        </div>
      </div>

      <!-- Ingest Mode Selector Tabs -->
      <div class="flex items-center gap-3 mb-5 border-b border-slate-700 pb-3 text-xs">
        <button type="button" id="tab-btn-company" class="font-bold text-emerald-400 border-b-2 border-emerald-400 pb-1">
          🏢 Company Career URL (Meezan, Systems, Jazz, SadaPay...)
        </button>
        <button type="button" id="tab-btn-social" class="font-medium text-slate-400 hover:text-white pb-1">
          📱 Social Media Post / Flyer (Instagram & Facebook Groups)
        </button>
      </div>

      <!-- Form 1: Standard Company Link Ingest -->
      <form id="fast-ingest-form" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Source URL -->
          <div class="sm:col-span-2 lg:col-span-3">
            <label class="block text-xs font-semibold text-slate-300 mb-1">Official Career / Application URL *</label>
            <input
              type="url"
              required
              id="ingest-url"
              placeholder="e.g. https://www.meezanbank.com/careers/ or SadaPay / Devsinc / Systems Ltd / Rozee / LinkedIn"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <!-- Title -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Position Title *</label>
            <input
              type="text"
              required
              id="ingest-title"
              placeholder="e.g. Backend Go Developer / Branch Banking Officer"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <!-- Company -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Employer / Startup / Enterprise *</label>
            <input
              type="text"
              required
              id="ingest-company"
              placeholder="e.g. SadaPay / Meezan Bank / Devsinc"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <!-- Employment Type -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Opportunity Type *</label>
            <select
              id="ingest-type"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
              <option value="FULL_TIME">💼 Full-Time Job</option>
              <option value="INTERN">🎓 Internship / Trainee</option>
              <option value="PART_TIME">⏱ Part-Time Job</option>
              <option value="CONTRACT">📄 Contractual Role</option>
            </select>
          </div>

          <!-- Category -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Hiring Sector *</label>
            <select
              id="ingest-category"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
              <option value="banking-finance">Banking & FinTech</option>
              <option value="computer-science">Computer Science & Software</option>
              <option value="engineering">Core Engineering</option>
              <option value="information-technology">Cloud & IT Infrastructure</option>
              <option value="supply-chain">Supply Chain & Operations</option>
              <option value="marketing-sales">Marketing & Sales</option>
              <option value="design-creative">UI/UX & Creative Design</option>
              <option value="human-resources">Human Resources</option>
            </select>
          </div>

          <!-- Location -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Location *</label>
            <input
              type="text"
              required
              id="ingest-location"
              placeholder="e.g. Karachi / Lahore / Islamabad / Nationwide / Remote"
              value="Karachi"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <!-- Mode -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Work Mode</label>
            <select
              id="ingest-mode"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
              <option value="onsite">Onsite</option>
              <option value="hybrid">Hybrid</option>
              <option value="remote">Remote across Pakistan</option>
            </select>
          </div>

          <!-- Compensation -->
          <div class="sm:col-span-2 lg:col-span-3">
            <label class="block text-xs font-semibold text-slate-300 mb-1">Stipend or Salary (Leave blank if undisclosed)</label>
            <input
              type="text"
              id="ingest-compensation"
              placeholder="e.g. PKR 110,000 - PKR 155,000 / month or PKR 45,000 / month (or leave empty)"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>
        </div>

        <div class="pt-3 flex justify-end">
          <button
            type="submit"
            id="btn-submit-fast-ingest"
            class="px-6 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black rounded-xl text-xs uppercase tracking-wider transition shadow-md"
          >
            ⚡ Auto-Generate Compliant Post & Stage for Review
          </button>
        </div>
      </form>

      <!-- Form 2: Social Media Post / Caption Ingest (Instagram & Facebook) -->
      <form id="social-ingest-form" class="space-y-4 hidden">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-300 mb-1">Instagram Post / Facebook Group Link *</label>
            <input
              type="url"
              required
              id="social-url"
              placeholder="e.g. https://www.instagram.com/p/... or https://www.facebook.com/groups/karachitechjobs/posts/..."
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Company / Studio / Agency Name *</label>
            <input
              type="text"
              required
              id="social-company"
              placeholder="e.g. Social Pulse Digital / NexScale Agency"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Position Title *</label>
            <input
              type="text"
              required
              id="social-title"
              placeholder="e.g. Creative Video Editor / Performance Marketer"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Hiring Sector *</label>
            <select
              id="social-category"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:outline-none focus:ring-2 focus:ring-emerald-500"
            >
              <option value="design-creative">UI/UX & Creative Design</option>
              <option value="marketing-sales">Marketing & Sales</option>
              <option value="computer-science">Computer Science & Software</option>
              <option value="human-resources">Human Resources</option>
              <option value="banking-finance">Banking & FinTech</option>
              <option value="information-technology">Cloud & IT</option>
              <option value="supply-chain">Supply Chain</option>
              <option value="engineering">Core Engineering</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Location / Mode</label>
            <input
              type="text"
              id="social-location"
              value="Lahore / Remote"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>

          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-300 mb-1">Paste Post Caption / Flyer Description (Our AI structures it)</label>
            <textarea
              id="social-caption"
              rows="3"
              placeholder="Paste the caption from the Instagram or Facebook post here (e.g. 'We are hiring! Looking for Graphic Designer with 1 yr exp. Salary 60-80k. Email CV to hr@company.com')"
              class="w-full text-xs p-3 rounded-xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 resize-none font-mono"
            ></textarea>
          </div>
        </div>

        <div class="pt-3 flex justify-end">
          <button
            type="submit"
            id="btn-submit-social-ingest"
            class="px-6 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-black rounded-xl text-xs uppercase tracking-wider transition shadow-md"
          >
            📱 Parse Social Post & Add to Review Queue
          </button>
        </div>
      </form>
    </div>

    <!-- Review Section Title & Filter Chips -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
      <div>
        <h2 class="text-xl font-bold text-slate-900">
          Discovered Opportunities Waiting for Your Verification
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">
          Click the official source link or social post to confirm details, then click "Publish" to push live.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-refresh-queue"
          class="text-xs font-bold text-emerald-700 hover:text-emerald-800 flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-emerald-200 bg-emerald-50"
        >
          <span>🔄 Refresh Queue</span>
        </button>
      </div>
    </div>

    <!-- Segment Filter Chips -->
    <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-6 text-xs" id="filter-chips-container">
      <button type="button" data-filter="all" class="filter-chip px-3 py-1.5 rounded-xl font-bold bg-slate-900 text-white shadow-sm">
        All Opportunities (<span id="count-all">0</span>)
      </button>
      <button type="button" data-filter="computer-science" class="filter-chip px-3 py-1.5 rounded-xl font-medium bg-white text-slate-700 border border-slate-200 hover:border-slate-400">
        💻 Software & CS (<span id="count-cs">0</span>)
      </button>
      <button type="button" data-filter="banking-finance" class="filter-chip px-3 py-1.5 rounded-xl font-medium bg-white text-slate-700 border border-slate-200 hover:border-slate-400">
        🏦 Banking & FinTech (<span id="count-banking">0</span>)
      </button>
      <button type="button" data-filter="engineering" class="filter-chip px-3 py-1.5 rounded-xl font-medium bg-white text-slate-700 border border-slate-200 hover:border-slate-400">
        ⚙️ Core Engineering (<span id="count-eng">0</span>)
      </button>
      <button type="button" data-filter="information-technology" class="filter-chip px-3 py-1.5 rounded-xl font-medium bg-white text-slate-700 border border-slate-200 hover:border-slate-400">
        ☁️ Cloud & IT (<span id="count-it">0</span>)
      </button>
      <button type="button" data-filter="marketing-sales" class="filter-chip px-3 py-1.5 rounded-xl font-medium bg-white text-slate-700 border border-slate-200 hover:border-slate-400">
        📈 Marketing & Sales (<span id="count-mkt">0</span>)
      </button>
      <button type="button" data-filter="design-creative" class="filter-chip px-3 py-1.5 rounded-xl font-medium bg-white text-slate-700 border border-slate-200 hover:border-slate-400">
        🎨 Design & Creative (<span id="count-des">0</span>)
      </button>
    </div>

    <!-- Queue Loading State -->
    <div id="queue-loading" class="py-16 text-center">
      <div class="w-8 h-8 border-4 border-emerald-600 border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
      <p class="text-xs text-slate-500 font-medium">Connecting to Supabase and loading verification queue...</p>
    </div>

    <!-- Database RLS Help Banner -->
    <div id="queue-rls-help" class="hidden mb-8 p-6 rounded-3xl bg-amber-50 border-2 border-amber-300 text-amber-950">
      <div class="flex items-center gap-2 font-bold text-sm mb-2 text-amber-900">
        <span>⚠️ Database Permission Required in Supabase</span>
      </div>
      <p class="text-xs text-amber-800 leading-relaxed mb-4">
        Your database currently has Row-Level Security (RLS) blocking public browsers from viewing or inserting <code class="bg-amber-100 px-1 py-0.5 rounded font-mono">pending_review</code> drafts. To unlock 1-click scanning and publishing:
      </p>
      <div class="bg-slate-900 text-emerald-400 p-4 rounded-2xl text-xs font-mono select-all">
        ALTER TABLE internships DISABLE ROW LEVEL SECURITY;
      </div>
      <p class="text-[11px] text-amber-700 mt-3">
        Copy this line, paste it into your <strong><a href="https://supabase.com/dashboard/project/dtjfpzbmtwfoljhqglca/sql/new" target="_blank" class="underline font-bold">Supabase SQL Editor</a></strong>, and click <strong>RUN</strong>. Then click Refresh Queue above!
      </p>
    </div>

    <!-- Queue Empty State -->
    <div id="queue-empty" class="hidden bg-white rounded-3xl border border-slate-200 p-12 text-center shadow-sm">
      <span class="text-4xl">🎉</span>
      <h3 class="text-lg font-bold text-slate-900 mt-2">Verification Queue Is Clear!</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
        All discovered opportunities have been verified and published. Click the green <strong>"📡 Scan 25+ Pakistan Targets"</strong> button above to load active jobs, startups, and social feeds.
      </p>
    </div>

    <!-- Live Queue Container -->
    <div id="queue-container" class="space-y-8"></div>
  </div>

  <!-- WhatsApp Broadcast Modal / Card Template -->
  <template id="tmpl-review-card">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden review-item-card transition hover:border-slate-300" data-category="">
      <!-- Top Bar -->
      <div class="bg-slate-900 text-white p-5 sm:p-6 flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-[10px] uppercase font-black tracking-wider px-2.5 py-0.5 rounded card-type-badge bg-blue-500 text-white">
              Full-Time Job
            </span>
            <span class="text-[10px] uppercase font-black tracking-wider px-2.5 py-0.5 rounded bg-amber-400 text-slate-950 card-category-badge">
              Category
            </span>
            <span class="text-xs text-slate-400 card-location-mode">
              Location • Mode
            </span>
          </div>
          <h3 class="text-lg sm:text-xl font-black mt-2 text-white card-title-company">
            Title at Company
          </h3>
        </div>

        <div>
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="card-source-link inline-flex items-center gap-2 text-xs font-bold px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white transition shadow-sm"
          >
            <span>🔗 Open Official Link / Post ↗</span>
          </a>
        </div>
      </div>

      <!-- Main Body -->
      <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Left: Details -->
        <div class="space-y-4">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5 space-y-2.5 text-xs">
            <div class="flex justify-between">
              <span class="text-slate-500">Compensation:</span>
              <span class="font-bold text-emerald-800 card-compensation">PKR 75,000 - PKR 95,000 / month</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Application Deadline:</span>
              <span class="font-bold text-slate-900 card-deadline">Rolling / Apply ASAP</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Nationality:</span>
              <span class="font-medium text-slate-900 card-nationality">Pakistani nationals only</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">Degree Prerequisite:</span>
              <span class="font-medium text-slate-900 card-degree">Relevant Degree / Portfolio</span>
            </div>
          </div>

          <!-- Editorial Intro -->
          <div class="rounded-2xl border border-slate-200 p-4">
            <span class="block text-[10px] font-bold uppercase text-slate-400 mb-1">Generated Editorial Summary</span>
            <p class="text-xs text-slate-700 leading-relaxed italic card-intro">
              Summary intro...
            </p>
          </div>
        </div>

        <!-- Right: The 1-Click Verification Action Box -->
        <div class="bg-emerald-50/60 rounded-2xl border-2 border-emerald-500/30 p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="w-5 h-5 rounded-full bg-emerald-600 text-white font-bold text-xs flex items-center justify-center">✓</span>
              <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wide">
                Human Gate Certifications (Pre-checked)
              </h4>
            </div>

            <div class="space-y-2.5 text-xs text-slate-700">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" checked class="chk-stipend rounded text-emerald-600 focus:ring-emerald-500" />
                <span>1. Verified Compensation against official post/link</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" checked class="chk-deadline rounded text-emerald-600 focus:ring-emerald-500" />
                <span>2. Verified Application Deadline</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" checked class="chk-nationality rounded text-emerald-600 focus:ring-emerald-500" />
                <span>3. Confirmed Pakistani applicant eligibility</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="checkbox" checked class="chk-degree rounded text-emerald-600 focus:ring-emerald-500" />
