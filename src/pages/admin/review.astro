            btnCopyWa.textContent = '📋 Copy WhatsApp Announcement';
          }, 3000);
        });

        // Reject Action
        btnReject.addEventListener('click', async () => {
          if (!confirm(`Are you sure you want to remove "${item.title}" from the review queue?`)) return;
          await supabase.from('internships').delete().eq('id', item.id);
          card.remove();
          allLoadedItems = allLoadedItems.filter((i) => i.id !== item.id);
          updateCounts(allLoadedItems);
        });

        queueContainer.appendChild(clone);
      });
