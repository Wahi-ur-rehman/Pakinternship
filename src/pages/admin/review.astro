    // Load Pending Review Queue
    async function loadQueue() {
      if (!queueContainer || !queueLoading || !queueEmpty || !queueRlsHelp) return;

      queueLoading.classList.remove('hidden');
      queueEmpty.classList.add('hidden');
      queueRlsHelp.classList.add('hidden');
      queueContainer.innerHTML = '';

      try {
        const { data, error } = await supabase
          .from('internships')
          .select('*')
          .eq('status', 'pending_review')
          .order('created_at', { ascending: false });

        queueLoading.classList.add('hidden');

        if (error) {
          console.error('Queue load error:', error);
          queueRlsHelp.classList.remove('hidden');
          return;
        }

        allLoadedItems = data || [];
        updateCounts(allLoadedItems);
        renderFilteredCards();
      } catch (err: any) {
        console.error('Fatal load error:', err);
        queueLoading.classList.add('hidden');
      }
    }

