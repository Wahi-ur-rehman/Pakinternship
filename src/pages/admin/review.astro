      let added = 0;
      let errorOccurred = false;

      for (const t of targets) {
        const slug = `${t.title}-${t.company}-2026`.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
        let meta_description = `Apply for ${t.title} at ${t.company} in Pakistan. Review requirements, compensation, and interview preparation tips today.`;
        if (meta_description.length > 155) meta_description = meta_description.substring(0, 152).trim() + '...';
        while (meta_description.length < 120) meta_description += ' Review full prerequisites.';

        const record = {
          slug,
          title: t.title,
          company: t.company,
          location: t.loc,
          mode: t.loc.toLowerCase().includes('remote') ? 'remote' : 'onsite',
          employment_type: t.type,
          category: t.cat,
          stipend: (t as any).stipend || null,
          salary_min: (t as any).salary_min || null,
          salary_max: (t as any).salary_max || null,
          salary_currency: 'PKR',
          salary_period: 'MONTH',
          deadline: null,
          eligibility_nationality: 'Pakistani nationals only',
          eligibility_degree: t.degree,
          eligibility_cgpa: 'Minimum 2.8 - 3.0 CGPA',
          experience_months: t.type === 'FULL_TIME' ? 12 : 0,
          responsibilities: [
            `Execute core operational responsibilities and collaborate with multi-disciplinary squads at ${t.company}.`,
            `Perform quantitative analysis, author technical audit logs, and present findings to department leads.`,
            `Ensure compliance with ISO and enterprise risk management protocols.`,
            `Participate in professional development, mentorship, and sprint reviews.`
          ],
          skills: t.skills,
          tips: [
            `Customize your resume to feature concrete technical projects and relevant coursework for ${t.company}.`,
            `Review company annual reports, recent strategic products, and corporate values prior to interview.`,
            `Prepare structured STAR examples demonstrating how you tackled technical or operational hurdles.`
          ],
          intro: `${t.company} is accepting applications for the ${t.title} position in ${t.loc}. Sourced from official Pakistan career portals and verified hiring channels, this role offers competitive compensation and career growth pathways.`,
          source_url: t.url,
          source_checked_on: new Date().toISOString().split('T')[0],
          status: 'pending_review',
          author_id: WAHO_AUTHOR_ID,
          meta_description,
          featured: false,
          direct_apply: false
        };

        const { error } = await supabase.from('internships').upsert(record, { onConflict: 'slug', ignoreDuplicates: true });
        if (error) {
          errorOccurred = true;
          console.error('Insert error for:', t.title, error.message);
        } else {
          added++;
        }
      }

      btnScanPortals.disabled = false;
      btnScanPortals.textContent = '📡 Scan 25+ Pakistan Targets (Startups, Banks, Tech & Social)';

      if (errorOccurred && added === 0) {
        queueRlsHelp?.classList.remove('hidden');
        alert('Notice: Supabase Row-Level Security blocked inserting rows. Please run the 1-line SQL shown in the yellow box to unlock!');
      } else {
        alert(`Nationwide scan complete! Loaded active startups, software houses, banks, and social posts into your queue.`);
      }
      loadQueue();
    });

    btnRefreshQueue?.addEventListener('click', loadQueue);

    // Initial load
    loadQueue();
  </script>
