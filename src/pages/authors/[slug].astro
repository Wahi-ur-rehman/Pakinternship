---
// ==============================================================================
// src/pages/authors/[slug].astro
// Author Bio & Attribution Page (Section 3 & 10 E-E-A-T Requirement)
// ==============================================================================

import Layout from '../../layouts/Layout.astro';
import { getAllAuthors, getAllListings } from '../../lib/supabase';
import type { Author, Listing } from '../../types/portal';

export async function getStaticPaths() {
  const authors = await getAllAuthors();
  const listings = await getAllListings();

  return authors.map((author) => {
    const authorListings = listings.filter((l) => l.author_id === author.id);
    return {
      params: { slug: author.slug },
      props: {
        author,
        listings: authorListings,
      },
    };
  });
}

interface Props {
  author: Author;
  listings: Listing[];
}

const { author, listings } = Astro.props;
const publishedListings = listings.filter((l) => l.status === 'published' || l.status === 'closed');
---

<Layout
  title={`${author.name} — ${author.role}`}
  description={`Read the career guides, verified job listings, and interview advice authored and fact-checked by ${author.name}.`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-emerald-700">Home</a>
      <span>/</span>
      <span>Authors</span>
      <span>/</span>
      <span class="text-slate-800 font-medium">{author.name}</span>
    </nav>

    <!-- Author Profile Card -->
    <header class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm mb-12">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6">
        {author.avatar_url && (
          <img
            src={author.avatar_url}
            alt={author.name}
            class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover border-2 border-emerald-600 shadow-sm"
          />
        )}
        <div class="text-center sm:text-left flex-1">
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 border border-emerald-200 mb-2">
            <span>Verified Editorial Contributor</span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
            {author.name}
          </h1>
          <p class="text-sm font-semibold text-emerald-800 mt-1">{author.role}</p>

          <p class="text-sm text-slate-600 mt-4 leading-relaxed">
            {author.bio}
          </p>

          {author.linkedin_url && (
            <div class="mt-4">
              <a
                href={author.linkedin_url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold text-slate-700 hover:text-emerald-700 inline-flex items-center gap-1.5 transition"
              >
                Connect on LinkedIn ↗
              </a>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Verified Articles & Listings by Author -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-slate-900">
          Reviewed & Verified Postings by {author.name}
        </h2>
        <span class="text-xs text-slate-500">{publishedListings.length} total entries</span>
      </div>

      <div class="space-y-4">
        {publishedListings.map((item) => (
          <article class="bg-white rounded-2xl border border-slate-200 p-5 hover:border-emerald-500 hover:shadow-md transition flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 mb-1.5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                  {item.employment_type === 'INTERN' ? 'Internship' : 'Job'}
                </span>
                <span class="text-xs text-slate-500 font-medium">
                  {item.company} • {item.location}
                </span>
                {item.status === 'closed' && (
                  <span class="text-[10px] font-bold text-amber-800 bg-amber-100 px-2 py-0.5 rounded">
                    Closed
                  </span>
                )}
              </div>

              <h3 class="text-base font-bold text-slate-900">
                <a href={`/${item.category}/${item.slug}`} class="hover:text-emerald-700 transition">
                  {item.title}
                </a>
              </h3>
            </div>

            <div class="text-right shrink-0">
              <a
                href={`/${item.category}/${item.slug}`}
                class="inline-flex items-center text-xs font-bold text-emerald-700 hover:underline"
              >
                Read Verification Details →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
