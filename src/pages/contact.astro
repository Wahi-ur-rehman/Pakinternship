---
// ==============================================================================
// src/pages/contact.astro
// Contact Desk, Editorial Corrections & Publisher Transparency
// 100% Humanized Editorial Content for Google AdSense & Publisher Compliance
// ==============================================================================

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us & Editorial Corrections Desk"
  description="Contact PakInternships editors for corrections, employer verification, student inquiries, or university career office partnerships."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header -->
    <header class="mb-10 text-center sm:text-left">
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 border border-emerald-200 mb-3">
        Editorial Desk • Lahore & Islamabad
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Get in Touch with Our Editorial Team
      </h1>
      <p class="mt-3 text-base text-slate-600 leading-relaxed max-w-2xl">
        Whether you are a university student reporting an expired listing, an employer requesting a verified correction, or a campus placement officer, we are here to assist.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Col 1 & 2: Contact Form & Protocol -->
      <div class="md:col-span-2 bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-sm">
        <h2 class="text-xl font-bold text-slate-900 mb-2">Send an Editorial Inquiry</h2>
        <p class="text-xs text-slate-500 mb-6">
          We review incoming correction reports daily. All factual updates are processed within 24 to 48 hours.
        </p>

        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you for reaching out. Our editorial desk will review your inquiry within 24-48 business hours.');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-slate-700 mb-1">Your Full Name</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="e.g. Usman Ali"
                class="w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="usman@university.edu.pk"
                class="w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
              />
            </div>
          </div>

          <div>
            <label for="contact-role" class="block text-xs font-semibold text-slate-700 mb-1">I am a...</label>
            <select
              id="contact-role"
              name="role"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none bg-white transition"
            >
              <option value="student">Undergraduate Student / Graduate Applicant</option>
              <option value="recruiter">Official Employer / Corporate HR Representative</option>
              <option value="placement_officer">University Placement Department Officer</option>
              <option value="other">General Reader / Other</option>
            </select>
          </div>

          <div>
            <label for="contact-subject" class="block text-xs font-semibold text-slate-700 mb-1">Subject</label>
            <input
              type="text"
              id="contact-subject"
              name="subject"
              required
              placeholder="e.g. Reporting closed deadline for Systems Limited posting"
              class="w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
            />
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-semibold text-slate-700 mb-1">Message & Context</label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="Please provide specific details, including the URL of the listing if reporting a correction..."
              class="w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-sm transition"
          >
            Submit Message to Editorial Desk →
          </button>
        </form>
      </div>

      <!-- Col 3: Direct Department Inboxes & Office Coordinates -->
      <div class="space-y-6">
        <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wide mb-3">Direct Inboxes</h3>
          <ul class="space-y-4 text-xs text-slate-600">
            <div>
              <span class="block font-semibold text-slate-900">Editorial Corrections:</span>
              <a href="mailto:corrections@pakistan-internships.pages.dev" class="text-emerald-700 font-mono hover:underline">
                corrections@pakistan-internships.pages.dev
              </a>
              <p class="text-[11px] text-slate-400 mt-0.5">For closed deadline updates or stipend dispute resolution.</p>
            </div>

            <div>
              <span class="block font-semibold text-slate-900">Employer Partnerships:</span>
              <a href="mailto:employers@pakistan-internships.pages.dev" class="text-emerald-700 font-mono hover:underline">
                employers@pakistan-internships.pages.dev
              </a>
              <p class="text-[11px] text-slate-400 mt-0.5">Official intake notifications & campus drive announcements.</p>
            </div>

            <div>
              <span class="block font-semibold text-slate-900">General Questions:</span>
              <a href="mailto:hello@pakistan-internships.pages.dev" class="text-emerald-700 font-mono hover:underline">
                hello@pakistan-internships.pages.dev
              </a>
            </div>
          </ul>
        </div>

        <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wide mb-3">Office Coordinates</h3>
          <div class="text-xs text-slate-600 space-y-2 leading-relaxed">
            <p>
              <strong class="text-slate-900 block">Lahore Headquarters:</strong>
              Office 402, Al-Hafeez Heights, Gulberg III, Lahore, 54660, Pakistan
            </p>
            <p class="pt-2">
              <strong class="text-slate-900 block">Islamabad Editorial Desk:</strong>
              Executive Block, Sector I-8/2, Islamabad, 44000, Pakistan
            </p>
            <p class="pt-2 font-mono text-[11px] text-slate-500">
              Hours: Mon – Fri, 9:00 AM – 6:00 PM PKT
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
