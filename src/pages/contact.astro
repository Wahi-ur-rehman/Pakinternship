---
// ==============================================================================
// src/pages/contact.astro
// Trust Page: Contact, Correction Requests & Publisher Information
// ==============================================================================

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us & Editorial Corrections"
  description="Contact the PakInternships editorial desk for factual corrections, employer verification inquiries, or student feedback."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-4">
        Contact Editorial Desk
      </h1>
      <p class="text-xs uppercase tracking-wider font-semibold text-emerald-800 bg-emerald-50 inline-block px-3 py-1 rounded-full border border-emerald-200 mb-6">
        Factual Accuracy & Inquiries
      </p>

      <!-- OWNER: REPLACE WITH HAND-WRITTEN COPY -->
      <div class="rounded-2xl border-2 border-dashed border-amber-300 bg-amber-50/70 p-6 my-6 text-amber-950">
        <h2 class="text-sm font-bold uppercase tracking-wide text-amber-900 mb-2">
          <!-- OWNER: REPLACE WITH HAND-WRITTEN COPY -->
        </h2>
        <p class="text-xs leading-relaxed">
          <strong>Site Owner Notice:</strong> Insert your verified official contact email address, office address (or city of operation in Pakistan), and expected turnaround time for correction inquiries (typically 24–48 hours).
        </p>
      </div>

      <div class="mt-8 space-y-6 text-sm text-slate-700">
        <div>
          <h3 class="font-bold text-slate-900 text-base mb-1">Direct Editorial Inquiries</h3>
          <p class="text-slate-600">For corrections regarding closed intakes, stipend updates, or employer disputes:</p>
          <p class="font-mono text-emerald-800 font-semibold mt-1">editorial@pakistan-internships.pages.dev</p>
        </div>

        <div>
          <h3 class="font-bold text-slate-900 text-base mb-1">Office Location</h3>
          <p class="text-slate-600">Lahore / Islamabad, Pakistan</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
