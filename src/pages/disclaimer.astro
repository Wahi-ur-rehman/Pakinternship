---
// ==============================================================================
// src/pages/disclaimer.astro
// Trust Page: Non-Affiliation & Compensation Disclaimer
// ==============================================================================

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Editorial Disclaimer & Non-Affiliation"
  description="Important disclaimers regarding company trademarks, government bodies, and salary benchmarks on PakInternships."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-4">
        Editorial & Non-Affiliation Disclaimer
      </h1>
      <p class="text-xs text-slate-500 mb-6">Last Updated: November 2026</p>

      <!-- OWNER: REPLACE WITH HAND-WRITTEN COPY -->
      <div class="rounded-2xl border-2 border-dashed border-amber-300 bg-amber-50/70 p-6 my-6 text-amber-950">
        <h2 class="text-sm font-bold uppercase tracking-wide text-amber-900 mb-2">
          <!-- OWNER: REPLACE WITH HAND-WRITTEN COPY -->
        </h2>
        <p class="text-xs leading-relaxed">
          <strong>Site Owner Notice:</strong> State your non-affiliation with Pakistani government agencies, public universities, or private corporate brands. Reiterate that logos and brand names belong to their respective trademark holders.
        </p>
      </div>

      <div class="prose prose-slate max-w-none text-slate-700 text-sm leading-relaxed space-y-4">
        <h2 class="text-lg font-bold text-slate-900">1. Trademark & Entity Independence</h2>
        <p>
          All company logos, brand trademarks, and organizational names referenced on PakInternships belong exclusively to their respective owners. Their mention does not imply sponsorship, endorsement, or direct partnership.
        </p>

        <h2 class="text-lg font-bold text-slate-900 mt-6">2. Zero Applicant Fees</h2>
        <p>
          PakInternships will never ask applicants for payment, registration fees, or processing charges. If any recruiter claiming to represent a listed opportunity requests money, do not engage.
        </p>
      </div>
    </div>
  </div>
</Layout>
