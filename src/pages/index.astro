---
// ==============================================================================
// src/pages/index.astro
// Production Homepage — Multi-Niche Hiring Portal for Pakistani Students
// ==============================================================================

import Layout from '../layouts/Layout.astro';
import { getPublishedListings, getAllCategories } from '../lib/supabase';
import type { Listing } from '../types/portal';

const publishedListings = await getPublishedListings();
const allCategories = getAllCategories();
const latestOpenListings = publishedListings.slice(0, 12);

const pageTitle = 'Verified Jobs & Internships in Pakistan (2026) — All Hiring Sectors';
const pageDescription = 'Pakistan’s dedicated, human-verified early-career portal. Discover verified tech, engineering, finance, marketing, design, HR, and supply chain opportunities with real stipends and deadlines.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white via-slate-50 to-slate-100 border-b border-slate-200 py-14 sm:py-20 px-4 sm:px-6">
    <div class="max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100 text-emerald-900 text-xs font-semibold mb-6 border border-emerald-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Zero Guesses • 100% Source-Verified Across All Major Hiring Sectors
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight max-w-4xl mx-auto">
        Verified Internships & Entry-Level Jobs Across Pakistan
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Targeting every major industry in Pakistan: Software Engineering, Electrical & Mechanical, Banking & FinTech, Growth Marketing, UI/UX, HR, and Supply Chain.
      </p>

      <!-- Category Filter Grid in Hero -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-4xl mx-auto text-left">
        {allCategories.map((cat) => (
          <a
            href={`/${cat.slug}`}
            class="p-3.5 rounded-2xl bg-white border border-slate-200 hover:border-emerald-500 hover:shadow-md transition group flex flex-col justify-between"
          >
            <div class="flex items-center justify-between">
              <span class="text-xl">{cat.icon}</span>
              <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
                {publishedListings.filter((l) => l.category === cat.slug).length} Open
              </span>
            </div>
            <span class="font-bold text-xs text-slate-900 mt-2 group-hover:text-emerald-700 transition line-clamp-1">
              {cat.shortName}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Editorial Mission & Unique 200+ Word Content (Section 10 Requirement) -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
        <div class="lg:col-span-2 prose prose-slate text-slate-700 text-sm sm:text-base leading-relaxed">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4">
            Transforming Early-Career Recruitment Across All Pakistani Industries
          </h2>
          <p>
            Securing a genuine professional internship or first junior role in Pakistan has historically been plagued by low-quality job aggregators, expired vacancies, misleading salary claims, and unpaid commercial exploitation. Students and graduates from leading institutions—such as FAST-NUCES, NUST, GIKI, LUMS, IBA, UET, and COMSATS—deserve clear, verified career intelligence.
          </p>
          <p class="mt-3">
            PakInternships operates on an uncompromising verification-first model. Rather than scraping thousands of outdated listings, we cover every core hiring sector—from enterprise software development, DevOps, and electrical power grids to Islamic banking, FMCG supply chain networks, digital marketing agencies, and product design studios.
          </p>
          <p class="mt-3">
            Every listing passes through our four-point verification gate. Accredited human editors verify the exact stipend numbers, official deadlines, academic qualifications, and Pakistani nationality eligibility before publication. We never estimate or fabricate compensation numbers. If an employer has not declared a figure, we state that explicitly, protecting students from unverified rumors.
          </p>
        </div>

        <div class="bg-slate-50 rounded-2xl border border-slate-200 p-6">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wide mb-4">
            The 4 Verification Pillars
          </h3>
          <ul class="space-y-3.5 text-xs text-slate-600">
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Explicit Stipends:</strong> Never AI-invented or estimated; literal fallback rendered if undisclosed.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Multi-Sector Verification:</strong> Verified against official career URLs within the last 30 days.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Historical Permanence:</strong> Expired postings stay live with closed status to power salary insights.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>E-E-A-T Accountability:</strong> Every published page carries a named human author byline.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Verified Opportunities Across All Sectors -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Latest Verified Openings</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Active corporate intakes accepting applications from Pakistani candidates</p>
      </div>
      <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
        {publishedListings.length} Total Verified Listings
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestOpenListings.map((listing) => (
        <article class="bg-white rounded-2xl border border-slate-200 hover:border-emerald-500 hover:shadow-lg transition p-6 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
                {listing.employment_type === 'INTERN' ? 'Internship' : 'Job'}
              </span>
              <span class="text-xs font-medium text-slate-500 uppercase">
                {listing.mode}
              </span>
            </div>

            <h3 class="font-bold text-slate-900 text-base group-hover:text-emerald-700 transition leading-snug">
              <a href={`/${listing.category}/${listing.slug}`}>
                {listing.title}
              </a>
            </h3>

            <p class="text-xs font-medium text-slate-600 mt-1.5 flex items-center gap-1.5">
              <span class="font-semibold text-slate-800">{listing.company}</span>
              <span>•</span>
              <span>{listing.location}</span>
            </p>

            <p class="text-xs text-slate-500 mt-3 line-clamp-2 leading-relaxed">
              {listing.intro}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="block text-[10px] text-slate-400 font-semibold uppercase">Stipend / Salary</span>
              <span class="text-xs font-bold text-emerald-800">
                {listing.stipend || (listing.salary_min ? `PKR ${listing.salary_min.toLocaleString()}` : 'Not disclosed')}
              </span>
            </div>

            <a
              href={`/${listing.category}/${listing.slug}`}
              class="inline-flex items-center gap-1 text-xs font-bold text-slate-900 group-hover:text-emerald-700 transition"
            >
              <span>View Requirements</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
