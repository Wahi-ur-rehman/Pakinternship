---
// ==============================================================================
// src/pages/index.astro
// Production Homepage (Section 10: 200+ words unique editorial, latest 10 open listings)
// ==============================================================================

import Layout from '../layouts/Layout.astro';
import { getPublishedListings } from '../lib/supabase';
import type { Listing } from '../types/portal';

const publishedListings = await getPublishedListings();
const latestOpenListings = publishedListings.slice(0, 10);

const pageTitle = 'Verified Engineering & IT Internships in Pakistan (2026)';
const pageDescription = 'Pakistan’s dedicated, human-verified tech career portal for university students. Discover verified software engineering, DevOps, and electrical internships with real stipends and deadlines.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white via-slate-50 to-slate-100 border-b border-slate-200 py-14 sm:py-20 px-4 sm:px-6">
    <div class="max-w-5xl mx-auto text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100 text-emerald-900 text-xs font-semibold mb-6 border border-emerald-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Zero Guesses • 100% Source-Verified Career Data
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight max-w-3xl mx-auto">
        Verified Engineering & Tech Internships for Pakistani Students
      </h1>

      <p class="mt-5 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Eliminating fraudulent job alerts, ambiguous requirements, and zero-stipend exploitation. Every opportunity is vetted against official employer announcements by experienced Pakistani engineering leads.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm font-semibold">
        <a
          href="/computer-science"
          class="px-5 py-3 rounded-xl bg-emerald-600 text-white hover:bg-emerald-700 shadow-sm transition"
        >
          Explore Computer Science →
        </a>
        <a
          href="/engineering"
          class="px-5 py-3 rounded-xl bg-white text-slate-800 border border-slate-300 hover:bg-slate-50 transition"
        >
          Electrical & Mechanical Tracks
        </a>
        <a
          href="/information-technology"
          class="px-5 py-3 rounded-xl bg-white text-slate-800 border border-slate-300 hover:bg-slate-50 transition"
        >
          Cloud & DevOps
        </a>
      </div>
    </div>
  </section>

  <!-- Editorial Mission & Unique 200+ Word Content (Section 10 Requirement) -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
        <div class="lg:col-span-2 prose prose-slate text-slate-700 text-sm sm:text-base leading-relaxed">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4">
            Our Editorial Standards & The Pakistani Student Tech Landscape
          </h2>
          <p>
            Securing a genuine technical internship in Pakistan is frequently undermined by inaccurate job aggregator bots, recycled outdated listings, and predatory unpaid arrangements. Pakistani university students across FAST, NUST, GIKI, UET, and COMSATS spend invaluable time preparing applications only to encounter broken links, unverified compensation claims, or retracted intakes.
          </p>
          <p class="mt-3">
            PakInternships operates on a strict verification-first philosophy. We deliberately reject the model of mass automated aggregation. Under our core operating rules, no listing may publish without an accredited human editor cross-checking four essential parameters: stated stipend figures, hard deadlines, degree eligibility under the Higher Education Commission (HEC) and Pakistan Engineering Council (PEC), and confirmed Pakistani nationality requirements.
          </p>
          <p class="mt-3">
            Our monthly publishing cadence is capped at 12 deeply vetted posts. This intentional constraint guarantees that every single guide contains actionable interview preparation tips, precise technology stack requirements, and an immutable historical record that remains accessible even after applications close.
          </p>
        </div>

        <div class="bg-slate-50 rounded-2xl border border-slate-200 p-6">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wide mb-4">
            The 4 Verification Pillars
          </h3>
          <ul class="space-y-3.5 text-xs text-slate-600">
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Explicit Stipends:</strong> Never AI-invented or estimated; literal fallback rendered if undisclosed.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Direct Source Vetting:</strong> Verified against official career URLs within the last 30 days.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>Historical Permanence:</strong> Expired postings stay live with closed status to power salary insights.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-600 font-bold">✓</span>
              <span><strong>E-E-A-T Accountability:</strong> Every published page carries a named human author byline.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest 10 Open Opportunities -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Latest Verified Opportunities</h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Open intakes accepting active applications from Pakistani candidates</p>
      </div>
      <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
        {latestOpenListings.length} Active Posts
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {latestOpenListings.map((listing) => (
        <article class="bg-white rounded-2xl border border-slate-200 hover:border-emerald-500 hover:shadow-lg transition p-6 flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
                {listing.employment_type === 'INTERN' ? 'Internship' : 'Full-Time Job'}
              </span>
              <span class="text-xs font-medium text-slate-500 uppercase">
                {listing.mode}
              </span>
            </div>

            <h3 class="font-bold text-slate-900 text-lg group-hover:text-emerald-700 transition leading-snug">
              <a href={`/${listing.category}/${listing.slug}`}>
                {listing.title} at {listing.company}
              </a>
            </h3>

            <p class="text-xs font-medium text-slate-600 mt-1.5 flex items-center gap-1.5">
              <span class="font-semibold text-slate-800">{listing.location}</span>
              <span>•</span>
              <span class="capitalize">{listing.category.replace('-', ' ')}</span>
            </p>

            <p class="text-xs text-slate-500 mt-3 line-clamp-2 leading-relaxed">
              {listing.intro}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="block text-[10px] text-slate-400 font-semibold uppercase">Stipend</span>
              <span class="text-xs font-bold text-emerald-800">{listing.stipend || 'Not disclosed'}</span>
            </div>

            <a
              href={`/${listing.category}/${listing.slug}`}
              class="inline-flex items-center gap-1 text-xs font-bold text-slate-900 group-hover:text-emerald-700 transition"
            >
              <span>View Requirements</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
