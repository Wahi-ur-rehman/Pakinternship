---
// ==============================================================================
// src/pages/terms.astro
// Legal Page: Terms of Service
// ==============================================================================

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Terms of Service"
  description="Terms and conditions governing access and informational use of PakInternships."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-12 shadow-sm">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mb-4">
        Terms of Service
      </h1>
      <p class="text-xs text-slate-500 mb-6">Last Updated: November 2026</p>

      <!-- OWNER: REPLACE WITH HAND-WRITTEN COPY -->
      <div class="rounded-2xl border-2 border-dashed border-amber-300 bg-amber-50/70 p-6 my-6 text-amber-950">
        <h2 class="text-sm font-bold uppercase tracking-wide text-amber-900 mb-2">
          <!-- OWNER: REPLACE WITH HAND-WRITTEN COPY -->
        </h2>
        <p class="text-xs leading-relaxed">
          <strong>Site Owner Notice:</strong> Formally state your terms regarding user conduct, non-liability for third-party hiring decisions, intellectual property rights, and governing jurisdiction.
        </p>
      </div>

      <div class="prose prose-slate max-w-none text-slate-700 text-sm leading-relaxed space-y-4">
        <h2 class="text-lg font-bold text-slate-900">1. Informational Directory Scope</h2>
        <p>
          PakInternships serves strictly as an informational and educational directory for university students. We are not an employment agency, headhunter, or employer.
        </p>

        <h2 class="text-lg font-bold text-slate-900 mt-6">2. Third-Party Hiring Decisions</h2>
        <p>
          All application submissions, interview invitations, and final job offers remain at the sole discretion of the hiring companies listed.
        </p>
      </div>
    </div>
  </div>
</Layout>
